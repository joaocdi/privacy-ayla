# =========================================================================
# DESENVOLVIMENTO (padrões seguros)
# =========================================================================
PORT=3334
NODE_ENV=development

# mock = PIX simulado, não pagável. Proibido em NODE_ENV=production.
PAYMENT_PROVIDER=mock

# Produção SyncPay: PAYMENT_PROVIDER=syncpay. Alternativa: sigilopay.
# Exclusivamente no backend; secret do webhook vem do cadastro oficial.
SYNCPAY_CLIENT_ID=
SYNCPAY_CLIENT_SECRET=
SYNCPAY_WEBHOOK_SECRET=

# Cadastro após pagamento. Habilitar apenas após revisão em staging.
BUYER_ACCOUNT_FLOW=true
# Staging usa PAYMENT_PROVIDER=staging, nunca SyncPay real.
# APP_ENV=staging
# STAGING_DATABASE_SCHEMA=staging_ayla_preview

# CORS. Vazio = mesma origem. Em produção, a URL do site.
FRONTEND_URL=http://localhost:3334

# SQLite local. Vazio = backend/db/database.sqlite.
# Ignorado quando DATABASE_URL estiver definida.
DATABASE_PATH=

# Telegram é opcional e fica desligado a menos que ligado explicitamente.
ENABLE_TELEGRAM_BOT=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=aylabl0nde_bot
TELEGRAM_VIP_CHAT_ID=

# =========================================================================
# SIGILOPAY  (só no backend — nunca no frontend)
# =========================================================================
SIGILOPAY_BASE_URL=https://app.sigilopay.com.br/api/v1
SIGILOPAY_PUBLIC_KEY=
SIGILOPAY_SECRET_KEY=

# Opcional: sobrescreve o callback. Sem isto, ele é derivado como
# ${PUBLIC_APP_URL}/api/payments/webhook. Só https é aceito.
SIGILOPAY_CALLBACK_URL=

# Preço do contato avulso. Disponível quando WHATSAPP_NUMBER é válido.
WHATSAPP_PRICE=7.90

# Botão "Chat" da HOME e do /vip: abre a conversa no WhatsApp.
# Só dígitos, com DDI e DDD (10 a 15 dígitos). Pontuação é ignorada.
# Exemplo brasileiro: 55 + DDD + número → 5548999990000
# Sem esta variável o botão mostra o aviso de "em breve" em vez de um link
# quebrado, e nenhum número é escrito no frontend ou no repositório.
# O destino só é devolvido após autenticação de uma compra de contato paga.
WHATSAPP_NUMBER=
# Opcional: mensagem já preenchida na conversa (até 200 caracteres).
WHATSAPP_MESSAGE=

# =========================================================================
# PRODUÇÃO
# =========================================================================
#   NODE_ENV=production
#   PAYMENT_PROVIDER=sigilopay
#
# URL pública do site. Obrigatória: é dela que sai o callback do webhook.
PUBLIC_APP_URL=

# PostgreSQL / Supabase. Quando definida, substitui o SQLite sem mudar código.
# Use a string do CONNECTION POOLER (porta 6543), não a 5432.
# postgresql://USER:SENHA@HOST:6543/postgres?sslmode=require
DATABASE_URL=

# Opcional: conexões por instância (serverless usa 1 por padrão na Vercel).
PGPOOL_MAX=

# Segredo do cron que expira acessos (/api/jobs/expire).
# Sem ele o endpoint não existe e a expiração não roda em serverless.
CRON_SECRET=

# =========================================================================
# ÁREA VIP (/vip)
# =========================================================================
# Assina os links de mídia. OBRIGATÓRIA em produção, 32+ caracteres.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VIP_MEDIA_SECRET=
VIP_MEDIA_TTL_SECONDS=900

# 'local'    → streaming das pastas privadas (desenvolvimento)
# 'supabase' → redirect para signed URL do bucket PRIVADO (produção)
VIP_MEDIA_DRIVER=local

# Driver local: pastas privadas. Nunca servidas como estático, nunca no git.
VIP_MEDIA_DIRS=Media_Ayla

# Driver supabase. O bucket PRECISA ser privado.
# service_role é chave administrativa: só no servidor, nunca no navegador.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
VIP_MEDIA_BUCKET=vip-ayla
# Validade da signed URL em segundos. Limitada a 60–300 (padrão 120).
SUPABASE_SIGNED_URL_TTL=120

# =========================================================================
# TESTE / DEV
# =========================================================================
# Não existem neste projeto: a rota que marca pedido como pago
# (POST /api/dev/orders/:orderId/pay) é liberada apenas quando
# NODE_ENV != production E PAYMENT_PROVIDER = mock, e ainda exige o
# Authorization: Bearer <checkoutToken> do próprio pedido.
# ALLOW_DEV_PAYMENTS  — não usada
# DEV_PAY_TOKEN       — não usada
#
# Banco de teste para `npm run test:pg`. NUNCA aponte para produção:
# esse teste apaga e recria as tabelas.
TEST_DATABASE_URL=

# ADMIN: credencial independente do comprador, somente backend/env.
# Gere uma chave aleatória de 32+ caracteres; nunca use a chave do Supabase.
# Sem esta configuração o painel não aceita login.
# LOGIN DA CRIADORA (Supabase Auth) — o caminho principal a partir de agora.
# Chave "anon/publishable" do projeto Supabase. Ela é feita para ser pública,
# mas aqui fica só no servidor: o navegador nunca a recebe, porque quem fala
# com o Supabase Auth é o backend. Sem ela, /login responde 503.
# Painel do Supabase: Project Settings -> API -> Project API keys -> anon.
SUPABASE_ANON_KEY=
# Opcional: chave própria para assinar o token anti-CSRF (32+ caracteres).
# Sem ela o sistema usa ADMIN_ACCESS_SECRET ou VIP_MEDIA_SECRET.
ADMIN_SESSION_SECRET=

ADMIN_ACCESS_SECRET=
# Origem exata do painel, sem caminho. Em produção pode usar PUBLIC_APP_URL.
# No dev: http://localhost:3333 (ou a origem realmente usada no navegador).
ADMIN_ORIGIN=
# Máximo por arquivo; blocos de 3 MiB permitem uploads pela Vercel.
ADMIN_UPLOAD_MAX_MB=250

# Dedicated Ayla PostgreSQL schema; never public.
DATABASE_SCHEMA=ayla
CREATOR_SLUG=ayla

# Opcional: Web Push transacional; gere um par VAPID por site.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
