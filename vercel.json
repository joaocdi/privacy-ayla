{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "buildCommand": "node build-public.js",
  "installCommand": "npm ci --prefix backend --omit=dev --omit=optional",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "{*.html,*.js,*.css,analytics.js,push.js,push-sw.js,continue.js,continue.html,avatar.jpg,cover.jpg,verified-ayla.png,favicon.ico,og.jpg,previews/*.jpg,backend/**}"
    }
  },
  "rewrites": [
    {
      "source": "/continuar",
      "destination": "/continue.html"
    },
    {
      "source": "/vip",
      "destination": "/vip.html"
    },
    {
      "source": "/criadora/login",
      "destination": "/login.html"
    },
    {
      "source": "/termos",
      "destination": "/legal.html"
    },
    {
      "source": "/privacidade",
      "destination": "/legal.html"
    },
    {
      "source": "/aviso-de-conteudo",
      "destination": "/legal.html"
    },
    {
      "source": "/contato",
      "destination": "/legal.html"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "path": "/api/jobs/expire",
      "schedule": "0 3 * * *"
    }
  ],
  "headers": [
    {
      "source": "/:page(index.html|vip.html|login.html|legal.html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/:asset(app.js|style.css|frame.js|frame.css|carousel.js|carousel.css|fonts.css|image-tools.js|pending-checkouts.js|vip.js|vip.css|buyer-account.js|buyer-account.css|admin-loader.js|admin-mode.js|admin-mode.css|tips.js|tips.css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/:asset(avatar.jpg|cover.jpg|verified-ayla.png|favicon.ico|og.jpg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/previews/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
