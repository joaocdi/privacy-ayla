{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "buildCommand": "node -e \"const fs=require('fs');fs.mkdirSync('public',{recursive:true});fs.copyFileSync('verified-ayla.png','public/verified-ayla.png');fs.cpSync('fonts','public/fonts',{recursive:true})\"",
  "installCommand": "npm ci --prefix backend --omit=dev --omit=optional",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "{*.html,*.js,*.css,avatar.jpg,cover.jpg,verified-ayla.png,favicon.ico,previews/*.jpg,backend/**}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "path": "/api/jobs/expire",
      "schedule": "0 3 * * *"
    }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/:asset(app.js|style.css|frame.js|frame.css|carousel.js|carousel.css|fonts.css|image-tools.js|pending-checkouts.js|vip.js|vip.css|buyer-account.js|buyer-account.css|admin-loader.js|admin-mode.js|admin-mode.css|tips.js|tips.css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/:asset(avatar.jpg|cover.jpg|verified-ayla.png|favicon.ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/previews/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
